{
  "name": "@plane31/blind-relay",
  "version": "0.6.0",
  "description": "Kavach v1 protocol: documents, cryptography, state machine. Pure TypeScript, no platform imports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plane31-org/kavach.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/plane31-org/kavach#readme",
  "bugs": {
    "url": "https://github.com/plane31-org/kavach/issues"
  },
  "keywords": [
    "end-to-end-encryption",
    "e2ee",
    "relay",
    "protocol",
    "circles",
    "sealed-records"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./sodium": {
      "types": "./dist/crypto/sodium.d.ts",
      "import": "./dist/crypto/sodium.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && KAVACH_CRYPTO=sodium vitest run",
    "test:noble": "vitest run",
    "test:sodium": "KAVACH_CRYPTO=sodium vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "libsodium-wrappers-sumo": "^0.7.15"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "esbuild": "0.21.5"
  }
}
